{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuse-spec.local/schemas/run-record.schema.json",
  "title": "Fuse canonical execution record",
  "type": "object",
  "required": [
    "schema_version",
    "spec_id",
    "run_id",
    "status",
    "started_at",
    "checkpointed_at",
    "spec_snapshot",
    "effective_policy_snapshot",
    "tasks",
    "assignments",
    "candidates",
    "evidence",
    "findings",
    "review_counters",
    "rca_attempts",
    "operator_decisions",
    "git"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "spec_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "run_id": { "type": "string", "pattern": "^run_[0-9a-f]{32}$" },
    "status": { "enum": ["running", "paused", "cancelled", "completed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "checkpointed_at": { "type": "string", "format": "date-time" },
    "spec_snapshot": { "$ref": "#/$defs/specSnapshot" },
    "effective_policy_snapshot": { "type": "object" },
    "tasks": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": { "$ref": "#/$defs/taskState" }
      },
      "additionalProperties": false
    },
    "assignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/assignment" }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "review_counters": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewCounter" }
    },
    "rca_attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/rcaAttempt" }
    },
    "operator_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/operatorDecision" }
    },
    "git": { "$ref": "#/$defs/gitState" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "specSnapshot": {
      "type": "object",
      "required": ["revision", "digests"],
      "properties": {
        "revision": { "type": ["string", "null"] },
        "digests": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9._-]+$": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "taskState": {
      "type": "object",
      "required": ["status", "assignment_ids", "accepted_candidate_id"],
      "properties": {
        "status": {
          "enum": ["pending", "assigned", "in_progress", "accepted", "blocked", "cancelled"]
        },
        "assignment_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^asg_[0-9a-f]{32}$" },
          "uniqueItems": true
        },
        "accepted_candidate_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": [
        "id",
        "task_id",
        "method",
        "role_profile",
        "status",
        "reserved_capacity",
        "reservation_active",
        "created_at",
        "attempts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^asg_[0-9a-f]{32}$" },
        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "method": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "role_profile": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "status": { "enum": ["prepared", "launched", "unknown", "succeeded", "failed", "cancelled"] },
        "reserved_capacity": { "type": "integer", "minimum": 1 },
        "reservation_active": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attempt" }
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["id", "status", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^att_[0-9a-f]{32}$" },
        "status": { "enum": ["prepared", "launched", "unknown", "succeeded", "failed", "cancelled"] },
        "created_at": { "type": "string", "format": "date-time" },
        "host_handle": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "result": { "type": "object" }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "manifest", "source_provenance", "created_at"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/sha256" },
        "manifest": { "type": "object" },
        "source_provenance": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "required"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "candidate_id",
        "kind",
        "outcome",
        "summary",
        "created_at",
        "artifacts",
        "source_provenance",
        "tool_versions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^evd_[0-9a-f]{32}$" },
        "candidate_id": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["check", "review", "approval", "observation"] },
        "check_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "assignment_id": { "type": "string", "pattern": "^asg_[0-9a-f]{32}$" },
        "source_provenance": { "type": "object" },
        "tool_versions": { "type": "object" },
        "config_digest": { "$ref": "#/$defs/sha256" },
        "check_definition_digest": { "$ref": "#/$defs/sha256" },
        "outcome": { "enum": ["pass", "fail", "unavailable", "inconclusive"] },
        "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "created_at": { "type": "string", "format": "date-time" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      },
      "additionalProperties": false
    },
    "findingHistory": {
      "type": "object",
      "required": ["at", "action", "rationale", "evidence_ids"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "action": { "enum": ["opened", "reopened", "resolved", "dismissed", "deferred"] },
        "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^evd_[0-9a-f]{32}$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "task_id", "summary", "scope", "blocking", "status", "evidence_ids", "history", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^fnd_[0-9a-f]{32}$" },
        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "scope": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "blocking": { "type": "boolean" },
        "status": { "enum": ["open", "resolved", "dismissed", "deferred"] },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^evd_[0-9a-f]{32}$" },
          "uniqueItems": true
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/findingHistory" }
        },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "reviewCounter": {
      "type": "object",
      "required": ["scope_id", "level", "repairs_used", "limit"],
      "properties": {
        "scope_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "level": { "enum": ["task", "spec_pr", "whole_codebase"] },
        "repairs_used": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "rcaAttempt": {
      "type": "object",
      "required": ["finding_id", "attempts_used", "limit"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^fnd_[0-9a-f]{32}$" },
        "attempts_used": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "operatorDecision": {
      "type": "object",
      "required": ["id", "at", "decision", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^dec_[0-9a-f]{32}$" },
        "at": { "type": "string", "format": "date-time" },
        "decision": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "pullRequest": {
      "type": "object",
      "required": ["task_id", "provider", "repository", "number", "base", "head"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "repository": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "number": { "type": "integer", "minimum": 1 },
        "base": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "head": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "gitState": {
      "type": "object",
      "required": ["base_commit", "integration_branch", "current_commit", "pull_requests", "state_ref", "state_revision"],
      "properties": {
        "base_commit": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }] },
        "integration_branch": { "type": ["string", "null"] },
        "current_commit": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }] },
        "pull_requests": { "type": "array", "items": { "$ref": "#/$defs/pullRequest" } },
        "state_ref": { "type": ["string", "null"] },
        "state_revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
